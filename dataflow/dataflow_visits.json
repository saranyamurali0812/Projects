{
	"name": "dataflow_visits",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_landing_folder",
						"type": "DatasetReference"
					},
					"name": "SRCVisits"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage_Ls",
						"type": "LinkedServiceReference"
					},
					"name": "sourcepatientaccepted"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage_Ls",
						"type": "LinkedServiceReference"
					},
					"name": "SNKVisitAccepted"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage_Ls",
						"type": "LinkedServiceReference"
					},
					"name": "SNKVisitRejected"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage_Ls",
						"type": "LinkedServiceReference"
					},
					"name": "sinkmissmatchedrecors"
				}
			],
			"transformations": [
				{
					"name": "DRVVisitClean"
				},
				{
					"name": "WINVisitDuplicate"
				},
				{
					"name": "DRVVisitsRules"
				},
				{
					"name": "SPLVisitValid"
				},
				{
					"name": "existspatient"
				},
				{
					"name": "EXMissingPatient"
				},
				{
					"name": "select1"
				},
				{
					"name": "Addmissmatchcolumn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          visit_id as string,",
				"          patient_id as string,",
				"          hospital_id as string,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          diagnosis_code as string,",
				"          cost as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['landing/visit_raw.csv']) ~> SRCVisits",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     fileSystem: 'healthcare-stagging',",
				"     folderPath: 'staging/accepted/patient') ~> sourcepatientaccepted",
				"SRCVisits derive(visit_id = trim(visit_id),",
				"          patient_id = trim(patient_id),",
				"          hospital_id = trim(hospital_id),",
				"          admission_date = upper(trim(diagnosis_code)),",
				"          discharge_date = toDate(trim(toString(admission_date)), 'yyyy-MM-dd'),",
				"          diagnosis_code = toDate(trim(toString(discharge_date)), 'yyyy-MM-dd'),",
				"          cost_clean = toDecimal(trim(toString(cost)), 18, 2)) ~> DRVVisitClean",
				"DRVVisitClean window(over(visit_id),",
				"     asc(patient_id, true),",
				"     duplicate_rank = rowNumber()) ~> WINVisitDuplicate",
				"WINVisitDuplicate derive(rejection_reason = iif(     isNull(visit_id) || length(trim(toString(visit_id))) == 0,     'Missing visit_id',   \r",
				"  iif(         isNull(patient_id) || length(trim(toString(patient_id))) == 0,\r",
				"           'Missing patient_id',        \r",
				"            iif(             isNull(hospital_id) || length(trim(toString(hospital_id))) == 0,   \r",
				"                      'Missing hospital_id',            \r",
				"                       iif(                 isNull(admission_date),    \r",
				"                                    'Missing admission_date',       \r",
				"                                              iif(                     isNull(discharge_date),   \r",
				"                                                                'Missing discharge_date',          \r",
				"           iif(                         toDate(toString(discharge_date), 'yyyy-MM-dd') <  toDate(toString(admission_date), 'yyyy-MM-dd'),            \r",
				"                        'Discharge date before admission date',                        \r",
				"                         iif(                             isNull(cost_clean),   'Invalid or missing cost',   \r",
				"                          iif(                                 cost_clean < 0, 'Negative cost' ,''\r",
				"                                     )                         )                     )                 )             )         )     ) )) ~> DRVVisitsRules",
				"DRVVisitsRules split(rejection_reason == '',",
				"     disjoint: false) ~> SPLVisitValid@(Accepted, Rejected)",
				"SPLVisitValid@Accepted, sourcepatientaccepted exists(patient_id == patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> existspatient",
				"SPLVisitValid@Accepted, sourcepatientaccepted exists(patient_id == patient_id,",
				"     negate:true,",
				"     broadcast: 'auto')~> EXMissingPatient",
				"Addmissmatchcolumn select(mapColumn(",
				"          visit_id,",
				"          patient_id,",
				"          hospital_id,",
				"          admission_date,",
				"          discharge_date,",
				"          diagnosis_code,",
				"          cost,",
				"          rejected_column = rejection_reason",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"EXMissingPatient derive(Missmatch = 'patiend_id not found') ~> Addmissmatchcolumn",
				"existspatient sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: 'healthcare-stagging',",
				"     folderPath: 'staging/accepted/visits',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          visit_id,",
				"          patient_id,",
				"          hospital_id,",
				"          admission_date,",
				"          discharge_date,",
				"          diagnosis_code,",
				"          cost = cost_clean",
				"     )) ~> SNKVisitAccepted",
				"SPLVisitValid@Rejected sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: 'healthcare-stagging',",
				"     folderPath: 'staging/rejected/visits',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          visit_id,",
				"          patient_id,",
				"          hospital_id,",
				"          admission_date,",
				"          discharge_date,",
				"          diagnosis_code,",
				"          cost,",
				"          duplicate_rank,",
				"          rejection_reason",
				"     )) ~> SNKVisitRejected",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     fileSystem: 'healthcare-stagging',",
				"     folderPath: 'staging/rejected/visits/missmatched',",
				"     truncate: true,",
				"     partitionFileNames:['Vist_stagging'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkmissmatchedrecors"
			]
		}
	}
}