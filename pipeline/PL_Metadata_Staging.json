{
	"name": "PL_Metadata_Staging",
	"properties": {
		"activities": [
			{
				"name": "GM_Landing_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Landing_CSV",
						"type": "DatasetReference",
						"parameters": {
							"pFolder": "landing"
						}
					},
					"fieldList": [
						{
							"value": "childItems",
							"type": "Expression"
						},
						"exists",
						{
							"value": "Size",
							"type": "Expression"
						}
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter_landing",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_Landing_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_Landing_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(   equals(item().type,'File'),   endsWith(toLower(item().name),'.csv') )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "FE_Process_Source_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter_landing').output.value ",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "IF_Validate_File",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Metadata-filecheck",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(\n  activity('Get Metadata-filecheck').output.exists,\n  greater(activity('Get Metadata-filecheck').output.size,0)\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fileerror",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Missing or empty source file: ',item().name)",
												"type": "Expression"
											},
											"errorCode": "ER_001"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "CP-landing-staging",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings",
													"copyBehavior": "FlattenHierarchy"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_ADLS_Landing",
												"type": "DatasetReference",
												"parameters": {
													"pFoldername": "landing",
													"pfilename": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_Staging_Parquet",
												"type": "DatasetReference",
												"parameters": {
													"pFolderName": {
														"value": "@concat(\n  'staging/accepted/',\n  replace(item().name,'_raw.csv','')\n)",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Loq-count",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "CP-landing-staging",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "CopyLog",
											"value": {
												"value": "@json(concat(\n  '{\"Activity\":\"CP-landing-staging\",',\n  '\"RowsRead\":',string(activity('CP-landing-staging').output.rowsRead),',',\n  '\"RowsCopied\":',string(activity('CP-landing-staging').output.rowsCopied),\n  '}'\n))",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Copylog-count",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Loq-count",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "Logdata",
											"value": {
												"value": "@string(variables('CopyLog'))",
												"type": "Expression"
											}
										}
									}
								]
							}
						},
						{
							"name": "Get Metadata-filecheck",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_Landing",
									"type": "DatasetReference",
									"parameters": {
										"pFoldername": "landing",
										"pfilename": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists",
									{
										"value": "Size",
										"type": "Expression"
									}
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"CopyLog": {
				"type": "Array"
			},
			"Logdata": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-21T01:10:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}