{
	"name": "PL_Metadata_Staging",
	"properties": {
		"activities": [
			{
				"name": "GM_Landing_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Landing_CSV",
						"type": "DatasetReference",
						"parameters": {
							"pFolder": "landing"
						}
					},
					"fieldList": [
						{
							"value": "childItems",
							"type": "Expression"
						},
						{
							"value": "Size",
							"type": "Expression"
						}
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter_landing",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_Landing_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_Landing_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(   equals(item().type,'File'),   endsWith(toLower(item().name),'.csv') )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Metadata-filecheck",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Filter_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Landing",
						"type": "DatasetReference",
						"parameters": {
							"pFoldername": "landing",
							"pfilename": "@activity('Filter_landing').output.value[0].name"
						}
					},
					"fieldList": [
						"exists",
						{
							"value": "Size",
							"type": "Expression"
						}
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "IF_Validate_File",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Metadata-filecheck",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(\n    activity('Get Metadata-filecheck').output.size,\n    0\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fileerror",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Missing or empty source file: ',activity('Filter_landing').output.name)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Fileerror",
										"type": "Fail",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"message": {
												"value": "@concat('Missing or empty source file: ',item().name)",
												"type": "Expression"
											},
											"errorCode": "ER_001"
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "CP-landing-staging",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "ParquetSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings",
													"copyBehavior": "FlattenHierarchy"
												},
												"formatSettings": {
													"type": "ParquetWriteSettings"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_ADLS_Landing",
												"type": "DatasetReference",
												"parameters": {
													"pFoldername": "landing",
													"pfilename": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_Staging_Parquet",
												"type": "DatasetReference",
												"parameters": {
													"pFolderName": {
														"value": "@concat(\n  'staging/accepted/',\n  replace(item().name,'_raw.csv','')\n)",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Loq-count",
										"type": "AppendVariable",
										"dependsOn": [
											{
												"activity": "CP-landing-staging",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"userProperties": [],
										"typeProperties": {
											"variableName": "CopyLog",
											"value": {
												"value": "@json(concat(\n  '{\"Activity\":\"CP-landing-staging\",',\n  '\"RowsRead\":',string(activity('CP-landing-staging').output.rowsRead),',',\n  '\"RowsCopied\":',string(activity('CP-landing-staging').output.rowsCopied),\n  '}'\n))",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Copylog-count",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Loq-count",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "Logdata",
											"value": {
												"value": "@string(variables('CopyLog'))",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "dataflow_patient",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_patient",
									"type": "DataFlowReference"
								},
								"integrationRuntime": {
									"referenceName": "IR-Healthcare-Public",
									"type": "IntegrationRuntimeReference"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_hospital",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_patient",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_hospital",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_diagnosis",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_hospital",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_diagnosis",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_visits",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_diagnosis",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_visits",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			},
			{
				"name": "scd_dataflow",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "IF_Validate_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "scd_dataflow",
						"type": "DataFlowReference",
						"parameters": {
							"parameter1": "patient_id"
						}
					},
					"integrationRuntime": {
						"referenceName": "IR-Healthcare-Public",
						"type": "IntegrationRuntimeReference"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "scd_dataflow_Visit",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "scd_dataflow",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "scd_dataflow_Visit",
						"type": "DataFlowReference",
						"parameters": {
							"parameter1": "visit_id"
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "Stored procedure_auditlog",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "scd_dataflow_Visit",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_Save_DataFlow_Audit]",
					"storedProcedureParameters": {
						"DiagnosisRows": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.InsertTdt.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"DiagnosisRowsupdated": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.UpdateSNKDiag.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"HospitalRows": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.sinkTgtHospital.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"HospitalRowsupdated": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.UpdateTgtHospital.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"PatientRows": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.InsertTgtPatient.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"PatientRowsupdated": {
							"value": {
								"value": "@activity('scd_dataflow').output.runStatus.metrics.TrgtUpdate.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"PipelineRunId": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"VisitRows": {
							"value": {
								"value": "@activity('scd_dataflow_Visit').output.runStatus.metrics.InsertTgtVisit.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"VisitRowsupdated": {
							"value": {
								"value": "@activity('scd_dataflow_Visit').output.runStatus.metrics.TrgtUpdate.rowsWritten",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"CopyLog": {
				"type": "Array"
			},
			"Logdata": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-21T01:10:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}