{
	"name": "PL_Metadata_Staging",
	"properties": {
		"activities": [
			{
				"name": "GM_Landing_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Landing_CSV",
						"type": "DatasetReference",
						"parameters": {
							"pFolder": "landing"
						}
					},
					"fieldList": [
						{
							"value": "childItems",
							"type": "Expression"
						},
						{
							"value": "Size",
							"type": "Expression"
						}
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter_landing",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GM_Landing_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_Landing_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(   equals(item().type,'File'),   endsWith(toLower(item().name),'.csv') )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Metadata-filecheck",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Filter_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Landing",
						"type": "DatasetReference",
						"parameters": {
							"pFoldername": "landing",
							"pfilename": "@activity('Filter_landing').output.value[0].name"
						}
					},
					"fieldList": [
						"exists",
						{
							"value": "Size",
							"type": "Expression"
						}
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "IF_Validate_File",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Metadata-filecheck",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(\n    activity('Get Metadata-filecheck').output.size,\n    0\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fileerror",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat('Missing or empty source file: ',activity('Filter_landing').output.name)",
									"type": "Expression"
								},
								"errorCode": "ER_001"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "dataflow_patient",
							"type": "ExecuteDataFlow",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_patient",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_hospital",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_patient",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_hospital",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_diagnosis",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_hospital",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_diagnosis",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						},
						{
							"name": "dataflow_visits",
							"type": "ExecuteDataFlow",
							"dependsOn": [
								{
									"activity": "dataflow_diagnosis",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataflow": {
									"referenceName": "dataflow_visits",
									"type": "DataFlowReference"
								},
								"compute": {
									"coreCount": 8,
									"computeType": "General"
								},
								"traceLevel": "Fine"
							}
						}
					]
				}
			}
		],
		"variables": {
			"CopyLog": {
				"type": "Array"
			},
			"Logdata": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-21T01:10:26Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}